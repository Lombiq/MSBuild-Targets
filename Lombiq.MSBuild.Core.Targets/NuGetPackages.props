<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <SolutionSrcDir Condition="'$(SolutionSrcDir)' == '' AND Exists('..\..\..\..\src')">..\..\..\..\src</SolutionSrcDir>
    <SolutionSrcDir Condition="'$(SolutionSrcDir)' == '' AND Exists('..\..\..\src')">..\..\..\src</SolutionSrcDir>
    <LombiqHelpfulLibrariesPath Condition="!Exists($(LombiqHelpfulLibrariesPath))">$(SolutionSrcDir)\Libraries\Lombiq.HelpfulLibraries</LombiqHelpfulLibrariesPath>
  </PropertyGroup>

  <!-- ImportLombiqHelpfulLibrariesCli: Lombiq.HelpfulLibraries.Cli -->

  <ItemGroup Condition="'$(ImportLombiqHelpfulLibrariesCli)' == 'true' AND '$(NuGetBuild)' != 'true'">
    <ProjectReference Include="$(LombiqHelpfulLibrariesPath)\Lombiq.HelpfulLibraries.Cli\Lombiq.HelpfulLibraries.Cli.csproj"/>
  </ItemGroup>

  <ItemGroup Condition="'$(ImportLombiqHelpfulLibrariesCli)' == 'true' AND '$(NuGetBuild)' == 'true'">
    <PackageReference Include="Lombiq.HelpfulLibraries.Cli" Version="12.5.1-alpha.0.nest-643"/>
  </ItemGroup>

  <!-- ImportLombiqHelpfulLibrariesOrchardCore: Lombiq.HelpfulLibraries.OrchardCore -->

  <ItemGroup Condition="'$(ImportLombiqHelpfulLibrariesOrchardCore)' == 'true' AND '$(NuGetBuild)' != 'true'">
    <ProjectReference Include="$(LombiqHelpfulLibrariesPath)\Lombiq.HelpfulLibraries.OrchardCore\Lombiq.HelpfulLibraries.OrchardCore.csproj"/>
  </ItemGroup>

  <ItemGroup Condition="'$(ImportLombiqHelpfulLibrariesOrchardCore)' == 'true' AND '$(NuGetBuild)' == 'true'">
    <PackageReference Include="Lombiq.HelpfulLibraries.OrchardCore" Version="12.5.1-alpha.0.nest-643"/>
  </ItemGroup>

  <!-- ImportLombiqHelpfulLibrariesLinqToDb: Lombiq.HelpfulLibraries.LinqToDb -->

  <ItemGroup Condition="'$(ImportLombiqHelpfulLibrariesLinqToDb)' == 'true' AND '$(NuGetBuild)' != 'true'">
    <ProjectReference Include="$(LombiqHelpfulLibrariesPath)\Lombiq.HelpfulLibraries.LinqToDb\Lombiq.HelpfulLibraries.LinqToDb.csproj"/>
  </ItemGroup>

  <ItemGroup Condition="'$(ImportLombiqHelpfulLibrariesLinqToDb)' == 'true' AND '$(NuGetBuild)' == 'true'">
    <PackageReference Include="Lombiq.HelpfulLibraries.LinqToDb" Version="12.5.1-alpha.0.nest-643"/>
  </ItemGroup>

  <!-- ImportLombiqHelpfulLibrariesRefit: Lombiq.HelpfulLibraries.Refit -->

  <ItemGroup Condition="'$(ImportLombiqHelpfulLibrariesRefit)' == 'true' AND '$(NuGetBuild)' != 'true'">
    <ProjectReference Include="$(LombiqHelpfulLibrariesPath)\Lombiq.HelpfulLibraries.Refit\Lombiq.HelpfulLibraries.Refit.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(ImportLombiqHelpfulLibrariesRefit)' == 'true' AND '$(NuGetBuild)' == 'true'">
    <PackageReference Include="Lombiq.HelpfulLibraries.Refit" Version="12.5.1-alpha.0.nest-643" />
  </ItemGroup>

  <!-- ImportLombiqHelpfulLibrariesSourceGenerators: Lombiq.HelpfulLibraries.SourceGenerators -->

  <PropertyGroup Condition="'$(ImportLombiqHelpfulLibrariesSourceGenerators)' == 'true' AND '$(NuGetBuild)' != 'true' AND Exists('$(SolutionDir)src\Libraries\Lombiq.HelpfulLibraries\Lombiq.HelpfulLibraries.SourceGenerators\Lombiq.HelpfulLibraries.SourceGenerators.csproj')">
    <SourceGeneratorLocation>$(SolutionDir)src\Libraries\Lombiq.HelpfulLibraries\Lombiq.HelpfulLibraries.SourceGenerators\bin\Debug\netstandard2.0\Lombiq.HelpfulLibraries.SourceGenerators.dll</SourceGeneratorLocation>
    <SourceGeneratorLocation Condition="'$(Configuration)' != 'Debug'">
      $(SolutionDir)src\Libraries\Lombiq.HelpfulLibraries\Lombiq.HelpfulLibraries.SourceGenerators\bin\Release\netstandard2.0\Lombiq.HelpfulLibraries.SourceGenerators.dll
    </SourceGeneratorLocation>
  </PropertyGroup>

  <ItemGroup Condition="'$(ImportLombiqHelpfulLibrariesSourceGenerators)' == 'true' AND '$(NuGetBuild)' != 'true'">
    <ProjectReference Include="$(LombiqHelpfulLibrariesPath)\Lombiq.HelpfulLibraries.Attributes\Lombiq.HelpfulLibraries.Attributes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true"/>
    <ProjectReference Include="$(LombiqHelpfulLibrariesPath)\Lombiq.HelpfulLibraries.SourceGenerators\Lombiq.HelpfulLibraries.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup Condition="'$(ImportLombiqHelpfulLibrariesSourceGenerators)' == 'true' AND '$(NuGetBuild)' == 'true'">
    <PackageReference Include="Lombiq.HelpfulLibraries.Attributes" Version="12.5.1-alpha.0.nest-643" OutputItemType="Analyzer" ReferenceOutputAssembly="true"/>
    <PackageReference Include="Lombiq.HelpfulLibraries.SourceGenerators" Version="12.5.1-alpha.0.nest-643" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <!-- ImportLombiqHelpfulExtensions: Lombiq.HelpfulExtensions -->

  <ItemGroup Condition="'$(ImportLombiqHelpfulExtensions)' == 'true' AND '$(NuGetBuild)' != 'true'">
    <ProjectReference Include="$(SolutionSrcDir)\Modules\Lombiq.HelpfulExtensions\Lombiq.HelpfulExtensions\Lombiq.HelpfulExtensions.csproj"/>
  </ItemGroup>

  <ItemGroup Condition="'$(ImportLombiqHelpfulExtensions)' == 'true' AND '$(NuGetBuild)' == 'true'">
    <PackageReference Include="Lombiq.HelpfulExtensions" Version="11.1.1-alpha.0.nest-643"/>
  </ItemGroup>

  <!-- ImportLombiqHostingBuildVersionDisplay: Lombiq.Hosting.BuildVersionDisplay -->

  <ItemGroup Condition="'$(ImportLombiqHostingBuildVersionDisplay)' == 'true' AND '$(NuGetBuild)' != 'true'">
    <ProjectReference Include="$(SolutionSrcDir)\Modules\Lombiq.Hosting.BuildVersionDisplay\Lombiq.Hosting.BuildVersionDisplay\Lombiq.Hosting.BuildVersionDisplay.csproj"/>
  </ItemGroup>

  <ItemGroup Condition="'$(ImportLombiqHostingBuildVersionDisplay)' == 'true' AND '$(NuGetBuild)' == 'true'">
    <PackageReference Include="Lombiq.Hosting.BuildVersionDisplay" Version="7.0.1-alpha.2.nest-643"/>
  </ItemGroup>

  <!-- ImportLombiqVueJsResources: Lombiq.VueJs.Resources -->

  <ItemGroup Condition="'$(ImportLombiqVueJsResources)' == 'true' AND '$(NuGetBuild)' != 'true'">
    <ProjectReference Include="$(SolutionSrcDir)\Modules\Lombiq.VueJs\Lombiq.VueJs.Resources\Lombiq.VueJs.Resources.csproj"/>
  </ItemGroup>

  <ItemGroup Condition="'$(ImportLombiqVueJsResources)' == 'true' AND '$(NuGetBuild)' == 'true'">
    <PackageReference Include="Lombiq.VueJs.Resources" Version="9.0.2-alpha.1.nest-643"/>
  </ItemGroup>

  <!-- ImportLombiqTests: Lombiq.Tests -->

  <ItemGroup Condition="'$(ImportLombiqTests)' == 'true' AND '$(NuGetBuild)' != 'true'">
    <ProjectReference Include="$(SolutionTestDir)\Lombiq.Tests\Lombiq.Tests.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(ImportLombiqTests)' == 'true' AND '$(NuGetBuild)' == 'true'">
    <PackageReference Include="Lombiq.Tests" Version="5.0.0" />
  </ItemGroup>

  <!-- ImportLombiqTestsUI: Lombiq.Tests.UI -->

  <ItemGroup Condition="'$(ImportLombiqTestsUI)' == 'true' AND '$(NuGetBuild)' != 'true'">
    <ProjectReference Include="$(SolutionTestDir)\Lombiq.UITestingToolbox\Lombiq.Tests.UI\Lombiq.Tests.UI.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(ImportLombiqTestsUI)' == 'true' AND '$(NuGetBuild)' == 'true'">
    <PackageReference Include="Lombiq.Tests.UI" Version="14.2.1-alpha.0.nest-643" />
  </ItemGroup>

  <!-- ImportLombiqTestsUIAppExtensions: Lombiq.Tests.UI.AppExtensions -->

  <ItemGroup Condition="'$(ImportLombiqTestsUIAppExtensions)' == 'true' AND '$(NuGetBuild)' != 'true'">
    <ProjectReference Include="$(SolutionSrcDir)\..\test\Lombiq.UITestingToolbox\Lombiq.Tests.UI.AppExtensions\Lombiq.Tests.UI.AppExtensions.csproj"/>
  </ItemGroup>

  <ItemGroup Condition="'$(ImportLombiqTestsUIAppExtensions)' == 'true' AND '$(NuGetBuild)' == 'true'">
    <PackageReference Include="Lombiq.Tests.UI.AppExtensions" Version="14.2.1-alpha.0.nest-643" />
  </ItemGroup>

  <!-- ImportLombiqPrivacy: Lombiq.Privacy -->

  <ItemGroup Condition="'$(ImportLombiqPrivacy)' == 'true' AND '$(NuGetBuild)' != 'true'">
    <ProjectReference Include="$(SolutionSrcDir)\Modules\Lombiq.Privacy\Lombiq.Privacy\Lombiq.Privacy.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(ImportLombiqPrivacy)' == 'true' AND '$(NuGetBuild)' == 'true'">
    <PackageReference Include="Lombiq.Privacy" Version="10.0.1-alpha.5.osoe-1069.nest-643" />
  </ItemGroup>

  <!-- ImportLombiqPrivacyTestsUI: Lombiq.Privacy.Tests.UI -->

  <ItemGroup Condition="'$(ImportLombiqPrivacyTestsUI)' == 'true' AND '$(NuGetBuild)' != 'true'">
    <ProjectReference Include="$(SolutionSrcDir)\Modules\Lombiq.Privacy\Lombiq.Privacy.Tests.UI\Lombiq.Privacy.Tests.UI.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(ImportLombiqPrivacyTestsUI)' == 'true' AND '$(NuGetBuild)' == 'true'">
    <PackageReference Include="Lombiq.Privacy.Tests.UI" Version="10.0.1-alpha.0.osoe-935" />
  </ItemGroup>

</Project>
