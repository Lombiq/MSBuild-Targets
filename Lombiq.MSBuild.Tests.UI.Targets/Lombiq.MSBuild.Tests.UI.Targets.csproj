<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <Title>Lombiq MSBuild Targets - Test - UI</Title>
    <Authors>Lombiq Technologies</Authors>
    <Copyright>Copyright © 2025, Lombiq Technologies Ltd.</Copyright>
    <Description>Target for a UI testing projects.</Description>
    <PackageIcon>NuGetIcon.png</PackageIcon>
    <PackageTags>OrchardCore;Lombiq;AspNetCore;Test</PackageTags>
    <RepositoryUrl>https://github.com/Lombiq/MSBuild-Targets</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Lombiq/MSBuild-Targets/Lombiq.MSBuild.Test.UI.Targets/Readme.md</PackageProjectUrl>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Readme.md" />
    <None Include="NuGetIcon.png" Pack="true" PackagePath="" />
    <None Include="build\**" Pack="true" PackagePath="build\" />
    <None Include="Lombiq.MSBuild.Tests.UI.Targets.props" Pack="true" PackagePath="" />
    <None Include="..\Lombiq.MSBuild.Core.Targets\Lombiq.MSBuild.Core.Targets.props" Pack="true" PackagePath="" />
    <None Include="..\Lombiq.MSBuild.Core.Targets\NuGetPackages.props" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
