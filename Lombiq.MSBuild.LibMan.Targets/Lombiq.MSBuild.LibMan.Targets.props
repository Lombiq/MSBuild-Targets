<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Basic configuration -->

  <PropertyGroup>
    <ImportLombiqHelpfulLibrariesSourceGenerators>true</ImportLombiqHelpfulLibrariesSourceGenerators>
  </PropertyGroup>

  <!-- Import core props -->

  <Import Project="$(MSBuildThisFileDirectory)\..\Lombiq.MSBuild.Module.Targets\Lombiq.MSBuild.Module.Targets.props" />

  <!-- External packages -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.LibraryManager.Build" Version="3.0.71" />
  </ItemGroup>

  <!-- Additional files -->

  <ItemGroup>
    <AdditionalFiles Include="libman.json" />
  </ItemGroup>

</Project>
