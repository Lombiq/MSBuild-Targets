<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Basic configuration -->

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <OrchardCoreProjectType Condition="'$(OrchardCoreProjectType)' == '' ">Module</OrchardCoreProjectType>
  </PropertyGroup>

  <!-- Import core props -->

  <Import Project="$(MSBuildThisFileDirectory)../Lombiq.MSBuild.Core.Targets/Lombiq.MSBuild.Core.Targets.props" />

  <!-- External packages -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="OrchardCore.Module.Targets" Version="$(OrchardCoreVersion)" Condition="'$(OrchardCoreProjectType.Trim().ToUpperInvariant())' == 'MODULE'" />
    <PackageReference Include="OrchardCore.Theme.Targets" Version="$(OrchardCoreVersion)" Condition="'$(OrchardCoreProjectType.Trim().ToUpperInvariant())' == 'THEME'" />
    <PackageReference Include="OrchardCore.Application.Targets" Version="$(OrchardCoreVersion)" Condition="$(OrchardCoreProjectType.TrimStart().ToUpperInvariant().StartsWith('APP'))" />
    <PackageReference Include="OrchardCore.ResourceManagement" Version="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.DisplayManagement" Version="$(OrchardCoreVersion)" />
  </ItemGroup>

  <!-- Ensure recipes are included -->

  <ItemGroup>
    <EmbeddedResource Update="Recipes\**.recipe.json" Condition="Exists('Recipes')">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </EmbeddedResource>
  </ItemGroup>

</Project>
